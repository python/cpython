  <PropertyGroup Label="Globals">
    <ProjectGuid>{C4B8E1F2-3D6A-4B5C-9E7F-1A2B3C4D5E60}</ProjectGuid>
    <RootNamespace>pdcurses</RootNamespace>
    <SupportPGO>false</SupportPGO>
  </PropertyGroup>
  <Import Project="python.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <!-- Build a DLL, not a static library: _curses and _curses_panel both link
         PDCurses and must share its global screen state (SP, stdscr, the panel
         stack).  A static library gives each module its own copy, so panel
         calls would run against an uninitialized screen. -->
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="pyproject.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <TargetName>pdcurses</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PDCursesDir);$(PDCursesDir)\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- PDC_DLL_BUILD + CURSES_LIBRARY export the symbols from pdcurses.dll.
           PDC_WIDE builds the wide-character (cchar_t) API.  NDEBUG disables
           PDCurses' own internal assert()s, which are stricter than its
           release behavior (e.g. delscreen() asserts sp == SP but then handles
           sp != SP gracefully); we do not build the vendored library's asserts. -->
      <PreprocessorDefinitions>PDC_DLL_BUILD;CURSES_LIBRARY;PDC_WIDE;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level1</WarningLevel>
      <AdditionalOptions Condition="$(PlatformToolset) == 'ClangCL'">%(AdditionalOptions) -Wno-unused</AdditionalOptions>
    </ClCompile>
    <Link>
      <!-- The wincon port uses the console, common dialogs and, for beep(),
           the multimedia PlaySound() API. -->
      <AdditionalDependencies>user32.lib;advapi32.lib;gdi32.lib;comdlg32.lib;shell32.lib;winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(PDCursesDir)\pdcurses\*.c" />
    <ClCompile Include="$(PDCursesDir)\wincon\*.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
